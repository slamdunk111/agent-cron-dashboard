{
  "name": "agent-cron-dashboard-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the dsh personal workbench: community PR/issue watch + fleet cron monitoring.",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build-bundles.mjs",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "probe:domains": "node scripts/probe-domains.mjs",
    "smoke": "bash scripts/smoke-p0.sh",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "zod": "4.4.3"
  }
}
